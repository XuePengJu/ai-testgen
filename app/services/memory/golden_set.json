{
  "version": "V7.4",
  "desc": "记忆黄金测试集：5 场景 × 6 用例 = 30 条（preference_change / conflict / expiry / isolation / temporal_decay）。setup 按顺序经 sync_conversation_items 真实冲突裁决链路注入（非直接建行），检索走 retrieve.hybrid_search，全部数据驱动。temporal_decay 场景用 backdate_days 回拨 updated_at 覆盖老条目时间衰减路径。",
  "fact_fields": {
    "kind": "fact|preference|rule|todo|profile",
    "subject": "语义槽位名",
    "content": "条目正文",
    "confidence": "0-1",
    "prov": "assert|explicit|infer"
  },
  "expect_fields": {
    "top1_contains": "top1 召回正文必须包含（大小写不敏感）；缺省不校验",
    "top1_absent": "true = 期望零召回（越权隔离场景）",
    "forbidden_contains": "任何召回正文都不得包含的词",
    "state": {
      "active_content_contains": "该 subject 当前 active 正文须包含",
      "active_subject": "校验的 subject（缺省取 setup[0].subject）",
      "min_superseded": 0,
      "min_conflict": 0,
      "min_expired": 0
    }
  },
  "cases": [
    {
      "id": "pref-01",
      "scenario": "preference_change",
      "desc": "用户改口：回复语言从英文改为中文，新版生效旧版退场",
