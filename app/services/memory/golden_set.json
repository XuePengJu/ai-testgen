        {
          "kind": "preference",
          "subject": "回复语言偏好",
          "content": "用户偏好使用英文进行交流",
          "confidence": 0.9,
          "prov": "infer"
        },
        {
          "kind": "preference",
          "subject": "回复语言偏好",
          "content": "用户改口偏好使用中文进行交流",
          "confidence": 0.92,
          "prov": "explicit"
        }
      ],
      "query": "用户偏好什么语言交流",
      "expect": {
        "top1_contains": "中文",
        "forbidden_contains": [
          "英文"
        ],
        "state": {
          "active_content_contains": "中文",
          "min_superseded": 1
        }
      }
    },
