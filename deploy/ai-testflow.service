# systemd 服务：让后端在阿里云上常驻运行
# 用法：
#   sudo cp deploy/ai-testflow.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-testflow
# 说明：ExecStart 用宝塔已装好的 Python 3.13.14；若自建 venv 改成对应 uvicorn 路径即可。
[Unit]
Description=AI TestFlow Platform
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-testflow
Environment=ENV=production
EnvironmentFile=/root/ai-testflow/.env
ExecStart=/www/server/pyporject_evn/versions/3.13.14/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
