# 阿里百炼 / 通义千问 API Key
# 未填 Key 时：默认 AITF_ALLOW_DEMO=0 直接报错（不静默 mock，避免"假跑"误导）；
# 本地/现场演示想开箱即跑，把下方 AITF_ALLOW_DEMO 设为 1 才走演示兜底。
DASHSCOPE_API_KEY=

# 使用的模型名（留空用默认 qwen-plus）
MODEL_NAME=qwen-plus

# ===== 魔搭社区 ModelScope 免费推理（OpenAI 兼容）=====
# 注册 modelscope.cn → 绑定阿里云+实名认证 → 右上角头像「访问令牌」创建（格式 ms-xxxx）
# 留空则回退到上面的百炼 Key；两者都空 → mock 兜底
# 推理额度：每日 2000 次 / 单模型 500 次（按次数，不限 token）
MODELSCOPE_API_KEY=
# 默认模型（思考模式默认开启）：Qwen/Qwen3.8-27B / Qwen/Qwen3.8-Flash-Next / Qwen/Qwen3-Coder-30B-A3B-Instruct
MODELSCOPE_MODEL=Qwen/Qwen3.8-27B

# ===== V2 认证 =====
# JWT 签名密钥（生产必改；默认占位值时启动仅 WARNING，ENV=production 时拒启）
JWT_SECRET=change-me-in-production
# 部署环境：dev / production
ENV=dev
# 迁移脚本预置 admin 密码（可留空=随机生成打印一次）
ADMIN_BOOTSTRAP=

# ===== 前后端分离部署（Vercel 前端 + 阿里云后端）=====
# 允许跨域的前端域名，逗号分隔。生产环境必须填你的 Vercel 域名，不要留 "*"
# 例：CORS_ORIGINS=https://ai-testflow.vercel.app,https://your-domain.com
CORS_ORIGINS=*

# ===== 数据库（方案 A：SQLite / MySQL 双方言）=====
# 本地零配置用默认 sqlite 即可，无需改任何 DB_*；只有连 MySQL 才需要下面这组
DB_TYPE=sqlite                       # sqlite（默认）| mysql
# —— MySQL 连接（DB_TYPE=mysql 时生效；sqlite 下整组忽略）——
DB_HOST=127.0.0.1
DB_PORT=3306                         # 注意：ai-testflow 服务器改的是 3356，必须显式填
DB_USER=ai-testflow
DB_PASSWORD=                         # 真实密码填这里；特殊字符无需 URL 编码
DB_NAME=ai-testflow
DB_CHARSET=utf8mb4                    # 中文/emoji 必须
# —— 连接池（仅 MySQL 生效）——
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true                # 取连接前探活→断线自动重连（重要）
DB_POOL_RECYCLE=3600                 # 1h 回收，防超时被踢
DB_ECHO=false                        # 调试时置 true 打印 SQL
# 可选：直填完整 URL 优先于上面 DB_*（留空则按 DB_* 拼）
# DATABASE_URL=mysql+pymysql://ai-testflow:密码@<服务器IP>:3356/ai-testflow?charset=utf8mb4

# ===== V3 LangChain 迁移 =====
# LLM 调用后端：langchain（默认，init_chat_model + 统一 stream()）| httpx（旧直连应急回退）
AITF_LLM_BACKEND=langchain
# LangSmith 可观测（阶段 3）：注册 smith.langchain.com 获取 Key，留空不开启
# LANGSMITH_API_KEY=

# ===== 演示模式开关（V4.1 demo-guard）=====
# 0（默认）：未配模型 / 调用失败 → 直接报错，不做静默 mock
# 1：恢复演示兜底（模板回复明确标注 used_mock），本地/现场演示开箱即跑
AITF_ALLOW_DEMO=0
